# BEGIN 2026 static site
RewriteEngine On

# HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Legacy WP /tuotteet/ slugs -> new static pages
RewriteRule ^tuotteet/rengaskoneet/?$ /2026/rengaskoneet.html [R=301,L]
RewriteRule ^tuotteet/ajoneuvonostimet/?$ /2026/saksinostimet.html [R=301,L]
RewriteRule ^tuotteet/saksinostimet/?$ /2026/saksinostimet.html [R=301,L]
RewriteRule ^tuotteet/pilarinostimet/?$ /2026/pilarinostimet.html [R=301,L]
RewriteRule ^tuotteet/keventimet/?$ /2026/keventimet.html [R=301,L]

# Renamed product pages (old SEO URL -> new)
RewriteRule ^(2026/)?pilarinostimet-kaksipilarinostin-htl-3340\.html$ https://korjaamokoneet.fi/2026/pilarinostimet-kaksipilarinostin-htl-3440.html [R=301,L]

# Admin panel — bypass static site rewrite
RewriteRule ^admin(/.*)?$ - [L]

# Serve everything from 2026/
RewriteCond %{REQUEST_URI} !^/2026/
RewriteRule ^(.*)$ /2026/$1 [L]
# END 2026 static site

